VIN_HMAC_SECRET=generate-locally
PDF_EXTRACTION_MAX_PAGES=100
PDF_EXTRACTION_MAX_TEXT_ITEMS=100000
PDF_EXTRACTION_MAX_CHARACTERS=2000000
PDF_EXTRACTION_TIMEOUT_MS=15000
PDF_EXTRACTION_WORKER_MEMORY_MB=192

# Clave del proyecto de OpenAI. Configúrala solo en el entorno local; no la guardes en Git.
OPENAI_API_KEY=
# Modelo compatible con Responses API y Structured Outputs habilitado para tu proyecto.
OPENAI_MODEL=
# Tiempo máximo de una solicitud de orientación, en milisegundos.
OPENAI_TIMEOUT_MS=20000
